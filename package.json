{
  "name": "finance-academy",
  "version": "0.1.0",
  "private": true,
  "description": "A modular, interactive curriculum for finance, investing, trading and quantitative finance.",
  "scripts": {
    "build": "node scripts/build.mjs --all",
    "build:module": "node scripts/build.mjs",
    "module:new": "node scripts/create-module.mjs",
    "test": "npm run test:unit && npm run test:e2e",
    "test:unit": "node tests/unit/finance.test.cjs",
    "test:e2e": "npm run build && node tests/e2e/module-interactions.test.cjs && node tests/e2e/module-accessibility.test.cjs",
    "qa:interactions": "node tests/e2e/module-interactions.test.cjs",
    "qa:accessibility": "node tests/e2e/module-accessibility.test.cjs",
    "screenshot": "node scripts/screenshot.cjs"
  },
  "engines": {
    "node": ">=20"
  },
  "devDependencies": {
    "@fontsource/ibm-plex-mono": "^5.3.0",
    "@fontsource/ibm-plex-sans": "^5.3.0",
    "@fontsource/schibsted-grotesk": "^5.3.0",
    "@phosphor-icons/core": "^2.1.1",
    "playwright-core": "^1.63.0"
  }
}

